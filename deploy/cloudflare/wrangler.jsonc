{
  // Separate Worker from the dashboard Workers `real-neural-forge` and
  // `real-neural-forge-frontend`. This file is the only place that may route
  // henad.youneek.*, nous.youneek.* and forge.youneek.*. Keep it in deploy/cloudflare/.
  // A wrangler config at the repository root would change the dashboard builds.
  // Never name a Worker in this repo youneek-xyz.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "real-neural-forge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "containers": [
    {
      "class_name": "NeuralForgeContainer",
      "image": "registry.cloudflare.com/d74b0de637f4d9d9eb3efb9e13142784/real-neural-forge:main-9a327b4",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEURAL_FORGE",
        "class_name": "NeuralForgeContainer"
      }
    ]
  },
  // Lifecycle stays on this migration. Wrangler rejects a Durable Object
  // `exports` entry in the same file. Do not delete tag v1.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NeuralForgeContainer"] }
  ],
  // workers.dev stays on. Custom hostnames are additional routes.
  // henad.* is the Henad home. The old hosts nous.* and forge.* 301-redirect
  // there (signed-in visits get a one-time session hand-off first; see
  // src/auth/gate.ts and src/auth/handoff.ts). Keep the old routes so old
  // links, bookmarks and the Stripe webhook keep working.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "henad.youneek.dev",
      "zone_name": "youneek.dev",
      "custom_domain": true
    },
    {
      "pattern": "henad.youneek.xyz",
      "zone_name": "youneek.xyz",
      "custom_domain": true
    },
    {
      "pattern": "nous.youneek.dev",
      "zone_name": "youneek.dev",
      "custom_domain": true
    },
    {
      "pattern": "nous.youneek.xyz",
      "zone_name": "youneek.xyz",
      "custom_domain": true
    },
    {
      "pattern": "forge.youneek.xyz",
      "zone_name": "youneek.xyz",
      "custom_domain": true
    },
    {
      "pattern": "forge.youneek.dev",
      "zone_name": "youneek.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "WORKSPACES_DB",
      "database_name": "neural-forge-workspaces",
      "database_id": "13f8ec26-e2a0-41a6-b49d-a4ba4623082a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WORKSPACES",
      "bucket_name": "neural-forge-workspaces"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Every minute: fire due reminders/check-ins; hourly cleanup of old files.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Account emails (confirm address, reset password). Sending stays off until
  // the owner sends a test from the dashboard (app_settings.email_sending).
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["no-reply@youneek.dev"]
    }
  ],
  "vars": {
    "NEURAL_FORGE_CONFIG": "config/config.yaml",
    "NEURAL_FORGE_CHECKPOINT_URL": "https://github.com/AndrewGrayYouNeeK/Henad/releases/download/champions/champion-default.pt",
    "NEURAL_FORGE_STORAGE": "cloudflare",
    "NEURAL_FORGE_BINDINGS_URL": "http://bindings.neuralforge",
    "NEURAL_FORGE_PUBLIC_URL": "https://henad.youneek.dev",
    "NEURAL_FORGE_OWNER_EMAIL": "andrewgray@youneek.xyz",
    "HENAD_EMAIL_FROM": "no-reply@youneek.dev",
    "NEURAL_FORGE_AI_MODEL": "@cf/openai/gpt-oss-120b",
    "NEURAL_FORGE_AI_FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "NEURAL_FORGE_AI_DAILY_NEURONS": "25000",
    "NEURAL_FORGE_AI_FREE_DAILY_NEURONS": "10000",
    "NEURAL_FORGE_AI_PER_IP_DAILY_NEURONS": "3200",
    "NEURAL_FORGE_AI_PER_IP_DAILY_REQUESTS": "40",
    "NEURAL_FORGE_AI_RESERVE_NEURONS": "80",
    "NEURAL_FORGE_VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "NEURAL_FORGE_VISION_VISITOR_DAILY": "5",
    "NEURAL_FORGE_VISION_PUBLIC_DAILY": "120",
    "NEURAL_FORGE_VISION_OWNER_DAILY": "60"
  }
}
