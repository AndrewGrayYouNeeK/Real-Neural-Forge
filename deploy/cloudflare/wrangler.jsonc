{
  // Separate Worker from the dashboard Workers `real-neural-forge` and
  // `youneek-xyz`. Keep this file in deploy/cloudflare/. A wrangler config at
  // the repository root would change those Workers Builds.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "real-neural-forge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "NeuralForgeContainer",
      "image": "registry.cloudflare.com/d74b0de637f4d9d9eb3efb9e13142784/real-neural-forge:main-6ce3b6f",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEURAL_FORGE",
        "class_name": "NeuralForgeContainer"
      }
    ]
  },
  // Lifecycle stays on this migration. Wrangler rejects a Durable Object
  // `exports` entry in the same file. Do not delete tag v1.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NeuralForgeContainer"] }
  ],
  // workers.dev stays on. Custom hostnames are additional routes.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "forge.youneek.xyz",
      "zone_name": "youneek.xyz",
      "custom_domain": true
    },
    {
      "pattern": "forge.youneek.dev",
      "zone_name": "youneek.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "WORKSPACES_DB",
      "database_name": "neural-forge-workspaces",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WORKSPACES",
      "bucket_name": "neural-forge-workspaces"
    }
  ],
  "vars": {
    "NEURAL_FORGE_CONFIG": "config/config.yaml",
    "NEURAL_FORGE_CHECKPOINT_URL": "https://github.com/AndrewGrayYouNeeK/Real-Neural-Forge/releases/download/champions/champion-default.pt",
    "NEURAL_FORGE_STORAGE": "cloudflare",
    "NEURAL_FORGE_BINDINGS_URL": "https://real-neural-forge-api.youneekartifacts.workers.dev",
    "NEURAL_FORGE_OWNER_EMAIL": "andrew@youneek.xyz"
  }
}
